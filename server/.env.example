# BINTH.IN Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://binth_admin:your_secure_password@localhost:5432/binth_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_at_least_32_random_chars_generated_by_crypto
JWT_EXPIRES_IN=8h

# ─── Security ─────────────────────────────────────────────────────────────────
# Salt used to pseudonymize IP addresses before SHA-256 hashing. Generate similarly.
IP_HASH_SALT=replace_this_with_another_random_secret_salt_for_ip_hashing

# ─── CORS ─────────────────────────────────────────────────────────────────────
# When serving frontend from the same Express process, set to same origin:
CORS_ORIGIN=http://localhost:8000

# ─── Rate Limiting (Public Entry Endpoint) ────────────────────────────────────
RATE_LIMIT_MAX_ENTRIES=5
RATE_LIMIT_WINDOW_MS=600000
