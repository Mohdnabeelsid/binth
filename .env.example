# BINTH.IN — Environment Variables (Supabase + Vercel)
# For local development: copy to .env
# For Vercel production: set these in your Vercel Project Settings > Environment Variables

# ─── Server & Environment ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Supabase PostgreSQL Connection ──────────────────────────────────────────
# Replace with your Supabase Connection Pooler URI (Session 5432 or Transaction 6543)
# Found at: Supabase Dashboard > Project Settings > Database > Connection String (URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Supabase Project Details ────────────────────────────────────────────────
# Found at: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Cryptographic Security & Auth ──────────────────────────────────────────
# 64-char random hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_character_hex_secret
JWT_EXPIRES_IN=8h

# IP hash salt for pseudonymizing visitor QR telemetry
IP_HASH_SALT=replace_with_32_character_hex_salt

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX_ENTRIES=5
RATE_LIMIT_WINDOW_MS=600000

# ─── Default Super Admin (Used for database seed) ───────────────────────────
ADMIN_DEFAULT_EMAIL=admin@binth.in
ADMIN_DEFAULT_PASSWORD=BinthAdmin2026!
