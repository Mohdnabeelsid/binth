# BINTH.IN — Environment Configuration Reference
# Architecture: Netlify (Frontend) + Render (Node.js API) + Supabase (PostgreSQL)
# NEVER commit .env to version control.

# ─── Server & Environment ───────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ─── Supabase PostgreSQL Connection (Server-Only Secret) ─────────────────────
# Replace with your Supabase Connection Pooler URI (Transaction mode on Port 6543)
# Found at: Supabase Dashboard > Project Settings > Database > Connection String (URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-STRONG-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# ─── Cryptographic Security & Auth (Server-Only Secrets) ─────────────────────
# Generate 64-char random hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_at_least_64_character_cryptographically_random_secret
JWT_EXPIRES_IN=8h

# IP hash salt for pseudonymizing visitor QR telemetry
# Generate 32-char random hex: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
IP_HASH_SALT=replace_with_at_least_32_character_cryptographically_random_salt

# ─── Strict CORS Origin Allowlist (Comma-separated) ──────────────────────────
# Allow your Netlify production domain, staging domain, and localhost in development
CORS_ORIGIN=https://binth.in,https://www.binth.in,https://binth.netlify.app

# ─── Public Submission Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_MAX_ENTRIES=5
RATE_LIMIT_WINDOW_MS=600000

# ─── Initial Administrator Bootstrap (Run once with npm run db:init) ────────
ADMIN_DEFAULT_NAME="BINTH Administrator"
ADMIN_DEFAULT_EMAIL=admin@binth.in
ADMIN_DEFAULT_PASSWORD=replace_with_strong_private_admin_password_min_12_chars
